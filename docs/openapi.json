  "components": {
    "schemas": {
      "Area": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "coordinates": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 3,
            "title": "Coordinates"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000,
            "title": "Notes",
            "default": ""
          },
          "status": {
            "type": "string",
            "enum": [
              "planejada",
              "em_andamento",
              "concluida"
            ],
            "title": "Status",
            "default": "planejada"
          },
          "visit_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Visit Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "coordinates"
        ],
        "title": "Area"
      },
      "Body_upload_dataset_api_v1_datasets_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_dataset_api_v1_datasets_upload_post"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "CsvImport": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "default": "Dataset importado"
          },
          "csv": {
            "type": "string",
            "maxLength": 2000000,
            "minLength": 10,
            "title": "Csv"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "csv"
        ],
        "title": "CsvImport"
      },
      "DemoRequest": {
        "properties": {
          "confirm_synthetic": {
            "type": "boolean",
            "const": true,
            "title": "Confirm Synthetic"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirm_synthetic"
        ],
        "title": "DemoRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PixelDownload": {
        "properties": {
          "scene_id": {
            "type": "string",
            "pattern": "^LC0[89]_L2SP_[A-Za-z0-9_]{10,100}$",
            "title": "Scene Id"
          },
          "bbox": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Bbox"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scene_id",
          "bbox"
        ],
        "title": "PixelDownload"
      },
      "PredictRequest": {
        "properties": {
          "rows": {
            "items": {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            "type": "array",
            "maxItems": 2000,
            "minItems": 1,
            "title": "Rows"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{24}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "rows"
        ],
        "title": "PredictRequest"
      },
      "TrainRequest": {
        "properties": {
          "dataset_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Dataset Ids"
          },
          "feature_set": {
            "type": "string",
            "enum": [
              "spectral",
              "urban"
            ],
            "title": "Feature Set",
            "default": "spectral"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "temporal",
              "spatial"
            ],
            "title": "Strategy",
            "default": "temporal"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_ids"
        ],
        "title": "TrainRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Verification": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 16,
            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token"
        ],
        "title": "Verification"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}